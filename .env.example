# ==============================================================================
# IceEscape 统一环境配置文件模板 (.env.example)
# 使用方法：复制本文件为 .env 并根据需要修改配置
# ==============================================================================

# ==========================================
# --- 后端配置 (Backend Settings) ---
# ==========================================

# --- 项目基本信息 ---
PROJECT_NAME="IceEscape"
API_V1_STR="/api/v1"
DEBUG=true

# --- 数据库配置 ---
# 开发环境默认使用 PostgreSQL（通过 Docker Compose）
DATABASE_URL="postgresql://iceescape:your-password@db:5432/iceescape"

# PostgreSQL 数据库配置（Docker Compose 使用）
POSTGRES_USER=iceescape
POSTGRES_PASSWORD=请设置强密码（至少16位，包含大小写字母、数字和特殊字符）
POSTGRES_DB=iceescape

# --- 安全与认证配置 ---
# JWT 签名密钥 (生产环境必须修改为随机强密钥，可使用 openssl rand -hex 32 生成)
SECRET_KEY="dev-secret-key-change-in-production-32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30  # access token 30 分钟
REFRESH_TOKEN_EXPIRE_MINUTES=43200  # refresh token 30 天

# --- 默认超级管理员账户 ---
# 生产环境必须设置强密码！不设置则后端将拒绝启动 admin 登录
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# --- 服务端跨域及业务 URL 配置 ---
FRONTEND_URL="http://localhost:3000"
API_BASE_URL="http://localhost:8000"

# --- 爬虫服务配置 ---
XHS_API_URL="http://localhost:8001"

# --- 高德地图与地理编码配置 ---
# 必须配置实际的高德 Web 服务 Key 才能使用地理编码
AMAP_KEY=""
AMAP_API_BASE="https://restapi.amap.com/v5/place/text"
AMAP_REVERSE_GEOCODE_BASE="https://restapi.amap.com/v3/geocode/regeo"

# --- 地图提供商配置 ---
# 地图提供商选项：支持 "osm" (OpenStreetMap) 或 "amap" (高德地图)
MAP_PROFILE="amap"

# --- 和风天气 API 配置 ---
# 必须配置实际的和风天气 credentials 才能使用天气/指数查询
QWEATHER_SUB=""
QWEATHER_KID=""
# Docker 环境下默认路径为 /app/secrets/qweather_private_key.pem（无需修改）
# 私钥文件放入 secrets/ 目录即可，Docker Compose 会自动挂载到容器内 /app/secrets/
# 本地开发环境如需自定义路径，取消下方注释并修改路径
# QWEATHER_PRIVATE_KEY_PATH="/app/secrets/qweather_private_key.pem"
QWEATHER_API_BASE="https://api.qweather.com/v7"

# --- 代理服务器配置 (可选，留空则不使用) ---
# HTTP_PROXY="http://127.0.0.1:7890"
# HTTPS_PROXY="http://127.0.0.1:7890"

# --- 统一智能体模型配置 (Pydantic Settings 嵌套解析) ---
# 选择激活的模型提供商：支持 "aliyun" 或 "local_openai"
MODELS__LLM__PROVIDER="aliyun"
MODELS__LLM__MODEL="qwen3.5-flash"
MODELS__LLM__TEMPERATURE=0.6
MODELS__LLM__TIMEOUT_S=1000

MODELS__VLM__PROVIDER="aliyun"
MODELS__VLM__MODEL="qwen3.5-flash"
MODELS__VLM__TIMEOUT_S=1000
MODELS__VLM__CONCURRENCY=2

# --- 提供商配置 (只需配置与上面激活提供商对应的一组即可) ---

# 1. Aliyun (通义千问) 配置
MODELS__PROVIDERS__ALIYUN__BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
MODELS__PROVIDERS__ALIYUN__API_KEY="sk-your-aliyun-dashscope-api-key"
MODELS__PROVIDERS__ALIYUN__ENABLE_THINKING=false

# 2. Local OpenAI 兼容接口配置 (如不使用可不配置)
# MODELS__PROVIDERS__LOCAL_OPENAI__BASE_URL="http://localhost:3333/v1"
# MODELS__PROVIDERS__LOCAL_OPENAI__API_KEY="sk-your-local-openai-api-key"

# --- 安全与限流配置 ---
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# --- 生产环境 SSL 配置 (docker-compose.prod.yml 使用) ---
# 域名
DOMAIN=your-domain.com
# SSL 证书和私钥路径（相对于 docker-compose.prod.yml 所在目录）
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/cert.key
# 信任反向代理头（生产环境在 Nginx 后面必须开启）
TRUST_PROXY_HEADERS=true

# --- Secrets 目录配置 ---
# 存放和风天气私钥等敏感文件的目录（相对于 docker-compose 文件所在目录）
SECRETS_DIR=./secrets

# --- 文件上传配置 (可选) ---
# UPLOAD_DIR="uploads"
# MAX_UPLOAD_SIZE=10485760  # 10MB (以字节为单位)
# THUMBNAIL_MAX_SIZE=640
# THUMBNAIL_QUALITY=82
# MAX_GPX_UPLOAD_SIZE=2097152  # 2MB (以字节为单位)
# GPX_MAX_POINTS=20000

# --- 全文检索与超检配置 (可选) ---
# FTS_OVERFETCH_MULTIPLIER=10
# FTS_OVERFETCH_MAX=2000


# ==========================================
# --- 前端配置 (Frontend Settings) ---
# ==========================================

# --- Vite 环境配置 (必须以 VITE_ 前缀命名) ---
VITE_API_BASE_URL="http://localhost:8000"
VITE_API_V1_STR="/api/v1"
VITE_APP_NAME="IceEscape"
VITE_APP_VERSION="1.0.0"
VITE_NODE_ENV="production"
VITE_MAP_PROFILE="amap"
